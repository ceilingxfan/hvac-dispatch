# Copy this file to secrets.toml and fill in your ServiceTitan values.
# secrets.toml is gitignored — never commit real credentials.
#
# Where to get these:
# 1. ServiceTitan Developer Portal → create/open your app → App Key
# 2. In ServiceTitan (tenant) → Settings → Integrations / API Application Access
#    → Client ID + Client Secret for that app
# 3. Tenant ID is shown in the developer portal / API access screen for your company

[servicetitan]
client_id = "YOUR_CLIENT_ID"
client_secret = "YOUR_CLIENT_SECRET"
app_key = "YOUR_APP_KEY"
tenant_id = "YOUR_TENANT_ID"
environment = "production"
